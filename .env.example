# ── Switchy — variables d'environnement ──
# Copier en .env et adapter. Toutes les variables propres à Switchy sont
# préfixées SWITCHY_*. Aucune variable n'est obligatoire : le service démarre
# avec ses défauts.

# ── Serveur ──
SWITCHY_HOST=0.0.0.0
# Port (Pi-Web 3000/3005, WebClaw 3006, Libry 3007).
SWITCHY_PORT=3008

# ── Données ──
# Répertoire racine des données persistantes (volume docker) : journaux
# d'appels, configuration des services, clés — jamais dans un dépôt.
SWITCHY_DATA_DIR=/app/data

# ── Accès ──
# Limite de requêtes par minute et par IP.
SWITCHY_RATE_LIMIT_PER_MIN=600
# Clé d'API Switchy (secret). Laissée vide, l'API est OUVERTE au premier
# démarrage — pour tout configurer depuis l'interface. Renseignée, elle est
# exigée sur toutes les routes /api/*.
# SWITCHY_API_KEY=

# ── Runtime (modifiable à chaud depuis l'onglet Réglages) ──
# Limite globale de concurrence (requêtes LLM simultanées ; Ollama Pro : 3).
# SWITCHY_CONCURRENCY=3
# SWITCHY_LOG_LEVEL=info

# ── Journal d'appels (Lot 3) ──
# SWITCHY_CALLS_LOG_MODE=summary
# SWITCHY_CALLS_LOG_RETENTION_DAYS=7

# Tous ces réglages sont éditables depuis l'interface (résolution
# env ?? fichier ?? défaut) : seules SWITCHY_HOST/PORT/DATA_DIR/RATE_LIMIT_PER_MIN
# demandent un redémarrage (lues au démarrage).
